{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rocket-docs/rules.schema.json",
  "title": "ROCKET rules.json",
  "description": "Structure of docs/rules.json as generated by src/docs_gen.rs (cargo test). Values are extracted from live code; 'source' fields point at the implementing functions.",
  "type": "object",
  "required": [
    "meta",
    "persistence",
    "answer_pipeline",
    "leveling",
    "daily_quests",
    "missions",
    "xp_shop",
    "knowledge_base",
    "online_ai",
    "game_detection",
    "vibes",
    "titles",
    "achievements",
    "decorations",
    "codex"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "properties": {
        "app": { "type": "string" },
        "generator": { "type": "string" },
        "provenance_legend": { "type": "object" },
        "companion_documents": { "type": "array", "items": { "type": "string" } }
      }
    },
    "persistence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": { "type": "string" },
          "owner": { "type": "string" },
          "purpose": { "type": "string" }
        },
        "required": ["file", "owner", "purpose"]
      }
    },
    "answer_pipeline": {
      "type": "object",
      "properties": {
        "dispatch_order": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "step": { "type": "integer" },
              "handler": { "type": "string" },
              "rule": { "type": "string" }
            },
            "required": ["step", "handler", "rule"]
          }
        },
        "correction_prefixes": { "type": "array", "items": { "type": "string" } },
        "followup_triggers": { "type": "array", "items": { "type": "string" } },
        "vibe_command_prefixes": { "type": "array", "items": { "type": "string" } },
        "correction_semantics": { "type": "string" },
        "edge_cases": { "type": "array", "items": { "type": "string" } }
      }
    },
    "leveling": {
      "type": "object",
      "properties": {
        "max_level": { "type": "integer", "const": 50 },
        "xp_requirements_indexed_by_level": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 },
          "minItems": 50,
          "maxItems": 50,
          "description": "index i+1 = level; values nondecreasing (asserted by generator)"
        },
        "rank_bands": { "type": "array" },
        "rank_by_level": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "xp_required": { "type": "integer" },
              "rank": { "type": "string" }
            }
          }
        },
        "coins_rule": { "type": "object" },
        "xp_awards": {
          "type": "object",
          "description": "every XP award rule; each entry carries a 'source' function path"
        },
        "badges": { "type": "array" },
        "source": { "type": "string" }
      }
    },
    "daily_quests": {
      "type": "object",
      "properties": {
        "rolled_per_day": { "type": "integer", "const": 3 },
        "roll_algorithm": { "type": "string" },
        "reroll_rule": { "type": "string" },
        "progress_rule": { "type": "string" },
        "kinds": { "type": "array", "items": { "type": "string" } },
        "kind_triggers": { "type": "object" },
        "pool": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": { "type": "string" },
              "title": { "type": "string" },
              "target": { "type": "integer", "minimum": 1 },
              "xp_reward": { "type": "integer", "minimum": 1 }
            },
            "required": ["kind", "title", "target", "xp_reward"]
          }
        },
        "source": { "type": "string" }
      }
    },
    "missions": {
      "type": "object",
      "properties": {
        "model": { "type": "string" },
        "open_cap": { "type": "integer", "const": 5 },
        "cap_behavior": { "type": "string" },
        "duplicate_rule": { "type": "string" },
        "completion": { "type": "object" },
        "source": { "type": "string" }
      }
    },
    "xp_shop": {
      "type": "object",
      "properties": {
        "decoration_prices_by_rarity": {
          "type": "object",
          "required": ["Basic", "Common", "Rare", "Epic", "Legendary"]
        },
        "mystery_box": {
          "type": "object",
          "properties": {
            "price": { "type": "integer" },
            "outcome_distribution": { "type": "string" },
            "exhaustion": { "type": "string" },
            "insufficient_coins": { "type": "string" },
            "source": { "type": "string" }
          }
        },
        "buy_decoration_rules": { "type": "array", "items": { "type": "string" } },
        "categories": { "type": "array", "items": { "type": "string" } },
        "source": { "type": "string" }
      }
    },
    "knowledge_base": {
      "type": "object",
      "properties": {
        "categories": { "type": "array", "items": { "type": "string" } },
        "entry_shape": { "type": "object" },
        "search_rules": { "type": "array", "items": { "type": "string" } },
        "answer_sources": { "type": "object" },
        "total_entries": { "type": "integer", "minimum": 100 },
        "games_with_packs": { "type": "integer" },
        "per_game": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "game": { "type": "string" },
              "entries": { "type": "integer" },
              "by_category": { "type": "object" }
            }
          }
        },
        "per_category_totals": { "type": "object" },
        "source": { "type": "string" }
      }
    },
    "online_ai": {
      "type": "object",
      "properties": {
        "mode_storage": { "type": "string" },
        "providers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "base_url": { "type": "string" },
              "default_model": { "type": "string" },
              "requires_key": { "type": "boolean" },
              "key_hint": { "type": "string" }
            },
            "required": ["id", "label", "base_url", "default_model", "requires_key"]
          }
        },
        "request_shape": { "type": "string" },
        "system_prompt": { "type": "string" },
        "fallback_rules": { "type": "array", "items": { "type": "string" } },
        "source": { "type": "string" }
      }
    },
    "game_detection": {
      "type": "object",
      "properties": {
        "enabled_by_default": { "type": "boolean" },
        "toggle_storage": { "type": "string" },
        "platform": { "type": "string" },
        "poll_interval_seconds": { "type": "integer" },
        "process_count": { "type": "integer" },
        "processes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "process": { "type": "string" },
              "game": { "type": "string" }
            }
          }
        },
        "source": { "type": "string" }
      }
    },
    "vibes": {
      "type": "object",
      "properties": {
        "vibes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "intro": { "type": "string" }
            }
          }
        },
        "switch_commands": { "type": "string" },
        "persistence": { "type": "string" },
        "placeholders": { "type": "string" },
        "source": { "type": "string" }
      }
    },
    "titles": {
      "type": "object",
      "properties": {
        "count": { "type": "integer", "minimum": 100 },
        "titles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "icon": { "type": "string" },
              "name": { "type": "string" },
              "rarity": { "type": "string", "enum": ["Basic", "Common", "Rare", "Epic", "Legendary"] },
              "condition": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": ["level", "streak_days", "questions_answered", "facts_taught", "topics_mastered", "badges_earned", "total_xp"]
                  },
                  "value": { "type": "integer" }
                }
              },
              "requirement": { "type": "string" }
            }
          }
        },
        "rules": { "type": "array", "items": { "type": "string" } },
        "source": { "type": "string" }
      }
    },
    "achievements": {
      "type": "object",
      "properties": {
        "count": { "type": "integer" },
        "achievements": { "type": "array" },
        "source": { "type": "string" }
      }
    },
    "decorations": {
      "type": "object",
      "properties": {
        "count": { "type": "integer" },
        "decorations": { "type": "array" },
        "source": { "type": "string" }
      }
    },
    "codex": {
      "type": "object",
      "description": "The Order of the Eternal Codex progression layer (see docs/codex.md).",
      "properties": {
        "file": { "type": "string", "const": "codex_character.json" },
        "version": { "type": "integer", "minimum": 1 },
        "ranks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "rank": { "type": "string" },
              "min_level": { "type": "integer" },
              "sigil": { "type": "string" }
            }
          }
        },
        "realm_tiers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "tier": { "type": "string" },
              "lore_points": { "type": "integer" }
            }
          }
        },
        "quest_types": { "type": "array", "items": { "type": "string" } },
        "board_capacity": { "type": "integer" },
        "xp_model": { "type": "object" },
        "quest_rewards": { "type": "object" },
        "desk_commands": { "type": "array", "items": { "type": "string" } },
        "tree_atelier": {
          "type": "object",
          "description": "CREATE TREE — the quest-tree authoring environment (docs/codex.md §6).",
          "properties": {
            "feature": { "type": "string" },
            "archetypes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "archetype": { "type": "string" },
                  "rank_gate": { "type": "integer" }
                }
              }
            },
            "desk_commands": { "type": "array", "items": { "type": "string" } },
            "node_traceability": { "type": "string" },
            "completion": { "type": "string" }
          }
        },
        "chronicle_file": { "type": "string" },
        "caps": { "type": "object" }
      }
    }
  }
}
